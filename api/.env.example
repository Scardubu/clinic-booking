# Copy to .env for local dev (never commit .env). On Render, set these in the dashboard.

# Shared secret every request must send as the X-API-Key header.
# Generate one:  openssl rand -hex 24
API_KEY=change-me

# Neon: use the POOLED connection string (host contains "-pooler").
# Local:  postgres://user:pass@127.0.0.1:5432/clinic
# If your host uses a private CA, append:  &uselibpqcompat=true&sslmode=require
DATABASE_URL=postgres://user:pass@127.0.0.1:5432/clinic

# Optional
# PORT=3000          (Render injects this)
# DB_POOL_MAX=10
# LOG_LEVEL=info
